# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=caern
POSTGRES_PASSWORD=caern_secret
POSTGRES_DB=caern_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=caern_minio
MINIO_ROOT_PASSWORD=caern_minio_secret
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=caern-images
MINIO_USE_SSL=false

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_very_long_random_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=8
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Security ─────────────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ── AI Models ────────────────────────────────────────────────────────────────
YOLO_MODEL_PATH=/app/models/yolov8n.pt
SAM_MODEL_PATH=/app/models/sam_vit_h.pth
MODEL_CONFIDENCE_THRESHOLD=0.5
GPU_TIMEOUT_SECONDS=180

# ── Email / SMTP ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=smtp_password
SMTP_FROM=CAERN Platform <noreply@example.com>

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://caern.local
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=500
